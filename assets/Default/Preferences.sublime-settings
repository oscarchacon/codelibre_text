// Default settings for CodeLibre Text.
// Do not edit this file: put your own settings in
// Packages/User/Preferences.sublime-settings (Preferences > Settings).
{
	// Language of menus, panels and messages (not a Sublime Text setting): "auto" follows the
	// operating system; or a code such as "en", "es", "pt_BR" (Preferences > Language…).
	// Built in: en, de, es, fr, pt_BR; packages add more with Localization/<code>.po files.
	"language": "auto",

	// Color scheme: a .sublime-color-scheme or .tmTheme from any package, by file name.
	// Built in: Monokai, Daylight, and syntect's defaults
	// (base16-ocean.dark, base16-eighties.dark, base16-mocha.dark,
	// base16-ocean.light, InspiredGitHub, Solarized (dark), Solarized (light)).
	"color_scheme": "Monokai.sublime-color-scheme",

	// Point size of the editor font
	"font_size": 11,

	// Number of columns a tab character occupies
	"tab_size": 4,

	// Insert spaces when tab is pressed
	"translate_tabs_to_spaces": false,

	// Copy the indentation of the current line when pressing enter
	"auto_indent": true,

	// Wrap long lines
	"word_wrap": false,

	// Show line numbers in the gutter
	"line_numbers": true,

	// Highlight the line the caret is on
	"highlight_line": true,

	// Columns to draw vertical rulers at, e.g. [80, 120]
	"rulers": [],

	// Allow scrolling past the last line
	"scroll_past_end": true,

	// Remove trailing white space on save: false / "none", true / "all", or
	// "not_on_caret" (keep the white space of the line with the caret).
	"trim_trailing_white_space_on_save": false,

	// Trim on save only the lines changed since the file was last saved.
	"trim_only_modified_white_space": true,

	// Show the auto-complete list while typing a word where "auto_complete_selector" matches,
	// or a character of "auto_complete_triggers" (Ctrl+Space shows it anywhere). It offers the
	// plugins' completions, the packages' .sublime-completions and snippets, and the file's words.
	"auto_complete": true,
	"auto_complete_selector": "meta.tag, source - comment - string.quoted.double.block - string.quoted.single.block - string.unquoted.heredoc",
	"auto_complete_triggers": [{ "selector": "text.html, text.xml", "characters": "<" }],
	// Files larger than this (in bytes) do not show it while typing.
	"auto_complete_size_limit": 4194304,
	// Tab commits the selected completion; also Enter unless this is true.
	"auto_complete_commit_on_tab": false,
	// Milliseconds typing must stop before the list shows.
	"auto_complete_delay": 50,
	// The completions chosen before come first.
	"auto_complete_use_history": false,
	// Up at the top of the list goes to its end, and Down at its end to the top.
	"auto_complete_cycle": false,

	// Tab after a snippet's or a completion's trigger (typed in full) inserts it.
	"tab_completion": true,

	// Copy and cut with nothing selected take the whole line; pasting that line
	// puts it above the caret's line.
	"copy_with_empty_selection": true,

	// The font size set by "Reset Font Size" (unset: the default "font_size").
	// "default_font_size": 11,

	// Make sure the file ends with a newline on save
	"ensure_newline_at_eof_on_save": false,

	// "system", "windows" (CRLF) or "unix" (LF), used for new files
	"default_line_ending": "system",

	// Restore open folders and files on startup
	"hot_exit": true,

	// Show the status bar / side bar on startup
	"show_status_bar": true,
	"show_side_bar": true,

	// Hidden from the side bar and Goto Anything
	"folder_exclude_patterns": [".git", ".svn", ".hg", "CVS", "node_modules", "target", "__pycache__"],
	"file_exclude_patterns": ["*.pyc", "*.pyo", "*.exe", "*.dll", "*.obj", "*.o", "*.a", "*.lib", "*.so", "*.dylib", "*.ncb", "*.sdf", "*.suo", "*.pdb", "*.idb", ".DS_Store"],

	// Also load syntaxes, color schemes, keymaps, menus, command palette
	// entries and settings from an installed Sublime Text's Packages folder.
	"import_sublime_packages": true,

	// Run the Python plugins (.py files) of the packages, like Sublime Text.
	// They need Python 3 installed; see View > Show Console for their output.
	"python_plugins": true,

	// Path of the Python 3 interpreter for plugins. Empty: use py -3, python3,
	// python or the one `uv python find` reports, whichever works first.
	"python_interpreter": "",

	// Every plugin runs in that one Python, so there is no Python 3.3 host: Package Control then
	// installs every package's libraries for its newer host (Lib/python38), as in Sublime Text.
	"disable_plugin_host_3.3": true,

	// Packages that are not loaded at all. Package Control changes this list while it upgrades.
	"ignored_packages": ["Vintage"],

	// Save every file with a name before building.
	"save_all_on_build": true,

	// Show the build's output panel when a build starts.
	"show_panel_on_build": true,
}
