// Default settings for CodeLibre Text.
// Do not edit this file: put your own settings in
// Packages/User/Preferences.sublime-settings (Preferences > Settings).
{
	// Color scheme: a .sublime-color-scheme or .tmTheme from any package, by file name.
	// Built in: Monokai, Daylight, and syntect's defaults
	// (base16-ocean.dark, base16-eighties.dark, base16-mocha.dark,
	// base16-ocean.light, InspiredGitHub, Solarized (dark), Solarized (light)).
	"color_scheme": "Monokai.sublime-color-scheme",

	// Point size of the editor font
	"font_size": 11,

	// Number of columns a tab character occupies
	"tab_size": 4,

	// Insert spaces when tab is pressed
	"translate_tabs_to_spaces": false,

	// Copy the indentation of the current line when pressing enter
	"auto_indent": true,

	// Wrap long lines
	"word_wrap": false,

	// Show line numbers in the gutter
	"line_numbers": true,

	// Highlight the line the caret is on
	"highlight_line": true,

	// Columns to draw vertical rulers at, e.g. [80, 120]
	"rulers": [],

	// Allow scrolling past the last line
	"scroll_past_end": true,

	// Remove trailing white space on save: false, true / "all"
	"trim_trailing_white_space_on_save": false,

	// Make sure the file ends with a newline on save
	"ensure_newline_at_eof_on_save": false,

	// "system", "windows" (CRLF) or "unix" (LF), used for new files
	"default_line_ending": "system",

	// Restore open folders and files on startup
	"hot_exit": true,

	// Show the status bar / side bar on startup
	"show_status_bar": true,
	"show_side_bar": true,

	// Hidden from the side bar and Goto Anything
	"folder_exclude_patterns": [".git", ".svn", ".hg", "CVS", "node_modules", "target", "__pycache__"],
	"file_exclude_patterns": ["*.pyc", "*.pyo", "*.exe", "*.dll", "*.obj", "*.o", "*.a", "*.lib", "*.so", "*.dylib", "*.ncb", "*.sdf", "*.suo", "*.pdb", "*.idb", ".DS_Store"],

	// Also load syntaxes, color schemes, keymaps, menus, command palette
	// entries and settings from an installed Sublime Text's Packages folder.
	"import_sublime_packages": true,

	// Run the Python plugins (.py files) of the packages, like Sublime Text.
	// They need Python 3 installed; see View > Show Console for their output.
	"python_plugins": true,

	// Path of the Python 3 interpreter for plugins. Empty: use py -3, python3,
	// python or the one `uv python find` reports, whichever works first.
	"python_interpreter": "",
}
